# ─────────────────────────────────────────────────────────────────────────────
# All environment variables in one place, for reference.
#
# The apps read them from:
#   backend/.env          ← copy from backend/.env.example (fully commented)
#   frontend/.env.local   ← copy from frontend/.env.example
#
# Never commit real values — .env files are git-ignored.
# ─────────────────────────────────────────────────────────────────────────────

# ═══ backend/.env ════════════════════════════════════════════════════════════

# PostgreSQL (async driver)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/calling_agent

# Admin session signing secret: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Gemini (Google AI Studio key — free tier). Live model does STT + LLM + TTS.
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=
AGENT_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
# AGENT_VOICE=Puck
SUMMARY_MODEL=gemini-2.5-flash
# SUMMARY_PROVIDER=nvidia
# NVIDIA_API_KEY=

# Twilio — only needed for real phone calls (browser calls work without it)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Fallback caller ID. Add more numbers (per business, inbound routing) in the
# dashboard under Phone numbers — those take precedence.
TWILIO_PHONE_NUMBER=

# Public host Twilio can reach (no scheme). localhost:8000 is fine for browser calls only.
SERVER_HOST=localhost:8000
USE_TLS=false
PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
TWILIO_VALIDATE_SIGNATURE=true

# Call behaviour (optional)
# RING_TIMEOUT_SECONDS=30
# SILENCE_PROMPT_SECONDS=10
# SILENCE_HANGUP_SECONDS=30
# MAX_CALL_SECONDS=600

# Parallel calling / campaigns (optional)
# MAX_CONCURRENT_CALLS=5
# DIALER_ENABLED=true
# DIALER_INTERVAL_SECONDS=3
# DIAL_CALLS_PER_SECOND=1
# TRANSFER_RING_TIMEOUT_SECONDS=25

# ═══ frontend/.env.local ═════════════════════════════════════════════════════

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

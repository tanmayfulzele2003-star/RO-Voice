# Base URL of the FastAPI backend (see backend/.env.example). Used both by the
# browser (client components, via NEXT_PUBLIC_*) and by Server Components
# making server-side fetches. No trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public URL this dashboard is deployed at — only used to build the absolute
# sitemap.xml URL (src/app/sitemap.ts, robots.ts). This is an internal admin
# tool that disallows all crawling; harmless if left at the default. No
# trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ──────────────────────────────────────────────────────────────────────────────
# Database (managed Postgres — used in dev and prod alike, e.g. Neon/Render Postgres)
# ──────────────────────────────────────────────────────────────────────────────
# Async SQLAlchemy URL — note the `+asyncpg` driver.
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# ──────────────────────────────────────────────────────────────────────────────
# Google AI / ADK
# ──────────────────────────────────────────────────────────────────────────────

# Choose ONE platform:

# --- Option A: Gemini Live API (Google AI Studio) — free, great for development
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your_google_api_key_here

# --- Option B: Vertex AI Live API (Google Cloud) — enterprise, for production
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your_gcp_project_id
# GOOGLE_CLOUD_LOCATION=us-central1

# Model to use (native audio, recommended)
# Gemini Live API:   gemini-2.5-flash-native-audio-preview-12-2025
# Vertex AI Live API: gemini-live-2.5-flash-native-audio
AGENT_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# Prebuilt native-audio voice for the live agent. Optional — defaults to "Puck".
# Other common options: Kore, Aoede, Leda, Orus, Zephyr (availability depends
# on the selected AGENT_MODEL).
# AGENT_VOICE=Puck

# Post-call analysis model (plain text, NOT the Live API model above) — used
# once per call, after it ends, to extract structured requirements + summary.
SUMMARY_MODEL=gemini-2.5-flash

# ──────────────────────────────────────────────────────────────────────────────
# Post-call analysis provider (optional — defaults to gemini)
# ──────────────────────────────────────────────────────────────────────────────
# Set to "nvidia" to run the post-call summary/extraction step against an
# NVIDIA NIM endpoint (OpenAI-compatible) instead of Gemini. The live call
# itself always uses Gemini Live above, regardless of this setting.
# SUMMARY_PROVIDER=nvidia
# NVIDIA_API_KEY=nvapi-...
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_SUMMARY_MODEL=nvidia/nemotron-3-super-120b-a12b

# ──────────────────────────────────────────────────────────────────────────────
# Twilio
# ──────────────────────────────────────────────────────────────────────────────
# Find these in the Twilio Console: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Fallback caller ID when no number from the dashboard's Phone numbers pool
# applies. Optional once you've added numbers there.
TWILIO_PHONE_NUMBER=+15551234567

# ──────────────────────────────────────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────────────────────────────────────
# Public hostname that Twilio can reach (no scheme, no trailing slash).
# For local development, use ngrok: ngrok http 8000  → copy the *.ngrok-free.app host
# Example: SERVER_HOST=abc123.ngrok-free.app   ← NO https:// prefix!
# Browser calls only (no Twilio)? localhost:8000 with USE_TLS=false is fine.
SERVER_HOST=your_public_hostname_here

# Set to "false" for local HTTP/WS development (e.g., plain ngrok tunnels)
USE_TLS=true

# Port the uvicorn server listens on
PORT=8000

# Set to any non-empty value to enable uvicorn auto-reload (dev only)
# DEV_RELOAD=1

# Origin the Next.js dashboard is served from (CORS allow-list).
FRONTEND_ORIGIN=http://localhost:3000

# ──────────────────────────────────────────────────────────────────────────────
# Call behaviour (optional — defaults shown)
# ──────────────────────────────────────────────────────────────────────────────
# How long the customer's phone rings before the call counts as no-answer.
# RING_TIMEOUT_SECONDS=30
# Silence: agent checks in after SILENCE_PROMPT_SECONDS, ends the call politely
# after SILENCE_HANGUP_SECONDS.
# SILENCE_PROMPT_SECONDS=10
# SILENCE_HANGUP_SECONDS=30
# Hard cap on one conversation.
# MAX_CALL_SECONDS=600

# ──────────────────────────────────────────────────────────────────────────────
# Parallel calling, campaigns and human transfer (optional — defaults shown)
# ──────────────────────────────────────────────────────────────────────────────
# Phone calls at once across manual, campaign and inbound calls. Size it to
# your Twilio concurrency and Gemini Live concurrent-session quota.
# MAX_CONCURRENT_CALLS=5
# Background campaign dialer. Safe to run in several processes (contacts are
# claimed with SKIP LOCKED); set false to keep it to one.
# DIALER_ENABLED=true
# DIALER_INTERVAL_SECONDS=3
# Twilio's default outbound rate is 1 call per second per account.
# DIAL_CALLS_PER_SECOND=1
# How long a person's phone rings on transfer before the caller hears the
# "we'll call you back" fallback.
# TRANSFER_RING_TIMEOUT_SECONDS=25

# ──────────────────────────────────────────────────────────────────────────────
# Admin auth / security
# ──────────────────────────────────────────────────────────────────────────────
# Long random secret used to sign the admin session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# There is no default — the app refuses to issue/verify sessions without it.
SESSION_SECRET=

# Set to "false" only for local development without a real Twilio account/
# ngrok tunnel. Never disable in a real deployment — this is what stops a
# forged /voice or /call-status request from being trusted.
TWILIO_VALIDATE_SIGNATURE=true
